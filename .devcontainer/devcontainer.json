{
  "name": "Ultron Scanner",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers-extra/features/nmap-apt-get:1": {}
  },
  "forwardPorts": [5000],
  "portsAttributes": {
    "5000": { "onAutoForward": "openBrowser", "label": "Ultron Scanner" }
  },
  "postCreateCommand": "pip install flask python-nmap reportlab requests"
}
